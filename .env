API_KEY= # Nexon Open API 키 넣을 것
BASE_URL=https://open.api.nexon.com

# 길드 관련 API 엔드포인트
GUILD_ID_ENDPOINT=/maplestory/v1/guild/id
GUILD_BASIC_ENDPOINT=/maplestory/v1/guild/basic

# 캐릭터 관련 API 엔드포인트
CHARACTER_ID_ENDPOINT=/maplestory/v1/id
CHARACTER_BASIC_ENDPOINT=/maplestory/v1/character/basic
CHARACTER_FIANL_STAT=/maplestory/v1/character/stat
CHARACTER_UNION_INFO=/maplestory/v1/user/union

# API 요청 제한 설정
REQUEST_LIMIT=4  # 초당 요청 제한
DAILY_LIMIT=1000  # 하루 요청 제한
